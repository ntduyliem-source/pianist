# Normalise text files by default
*               text=auto

# Pinned upstream source must retain its exact Git blob/SHA-256 on Windows too.
third_party/practice-sources/** -text -whitespace
# Verbatim upstream method bodies retain upstream whitespace as well.
packages/practice-engine-v2/upstream/studio-wait.js -whitespace
tests/reference-runners/osu/GeneratedMethods.cs -whitespace

# Shell scripts with shebang lines must have LF line endings
*.sh            text            eol=lf
*.py            text            eol=lf
*.ps1           text            eol=lf
build.cmake     text            eol=lf

# Batch files need CRLF line endings
*.bat           text            eol=crlf
*.cmd           text            eol=crlf

# Windows PortableApps packaging files need CRLF line endings
buildscripts/packaging/Windows/PortableApps/**/*.ini eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.txt eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.ini.in eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.html eol=crlf

# Converter releases are verified against the original archive bytes.
third_party/score-format-sources/** -text -whitespace

# Corpus indices are byte-hashed by the lock manifest on Windows and Linux.
scores/curriculum/*.json text eol=lf

# Q2 native golden receipts bind to these exact original MusicXML bytes.
tests/fixtures/pianist/curriculum/*.musicxml text eol=lf
tests/fixtures/pianist/curriculum/*.json text eol=lf
buildscripts/pianist/curriculum-normalize-win-py311.lock text eol=lf
packages/exercise-generator/source-verification.ts text eol=lf
apps/pianist-web/tests/source-verification.test.ts text eol=lf
tests/browser/pianist/q2-* text eol=lf
docs/curriculum/q2/*.json text eol=lf

# Q3 content rules and review receipts are bound to byte hashes.
packages/exercise-generator/corpus-model.ts text eol=lf
tests/browser/pianist/q3-* text eol=lf
docs/curriculum/q3/*.json text eol=lf

# K3 upstream copies are verified byte-for-byte, including the MIT license.
third_party/curriculum-sources/pianoplayer/** -text -whitespace

# Authored grade editions and packaged ABC bytes must hash identically on Windows/Linux.
scores/grades/**/*.abc text eol=lf
scores/grades/**/*.txt text eol=lf
scores/grades/**/*.tsv text eol=lf
scores/grades/**/*.json text eol=lf
scores/grades/**/*.md text eol=lf
